{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "macos-release",
            "displayName": "macOS Release",
            "description": "Configure for macOS release distribution using Ninja. Requires QT_MACOS_ROOT, MACOS_NOTARY_KEYCHAIN_PROFILE, MACOS_APP_SIGN_IDENTITY, and MACOS_DMG_SIGN_IDENTITY environment variables.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/Qt_6_10_2_for_macOS",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_PREFIX_PATH": "$env{QT_MACOS_ROOT}",
                "QTQUICKTEMPLATE_MACOS_NOTARY_KEYCHAIN_PROFILE": "$env{MACOS_NOTARY_KEYCHAIN_PROFILE}",
                "QTQUICKTEMPLATE_MACOS_APP_SIGN_IDENTITY": "$env{MACOS_APP_SIGN_IDENTITY}",
                "QTQUICKTEMPLATE_MACOS_DMG_SIGN_IDENTITY": "$env{MACOS_DMG_SIGN_IDENTITY}"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "macos-appstore",
            "displayName": "macOS App Store (Xcode)",
            "description": "Configure for macOS App Store distribution using the Xcode generator. Requires QT_MACOS_ROOT, APPLE_DEVELOPMENT_TEAM, ASC_API_KEY_ID, and ASC_API_ISSUER_ID environment variables.",
            "generator": "Xcode",
            "binaryDir": "${sourceDir}/build/Qt_6_10_2_for_macOS_AppStore",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{QT_MACOS_ROOT}",
                "QTQUICKTEMPLATE_APPLE_DEVELOPMENT_TEAM": "$env{APPLE_DEVELOPMENT_TEAM}",
                "QTQUICKTEMPLATE_MACOS_APP_STORE_ARCHIVE_CONFIGURATION": "Release",
                "QTQUICKTEMPLATE_MACOS_APP_STORE_PROVISIONING_PROFILE": "$env{MACOS_APP_STORE_PROVISIONING_PROFILE}",
                "QTQUICKTEMPLATE_ASC_API_KEY_ID": "$env{ASC_API_KEY_ID}",
                "QTQUICKTEMPLATE_ASC_API_ISSUER_ID": "$env{ASC_API_ISSUER_ID}"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "ios-release",
            "displayName": "iOS Release (Xcode)",
            "description": "Configure for iOS using the Xcode generator and Qt's iOS toolchain. Requires QT_IOS_ROOT and APPLE_DEVELOPMENT_TEAM environment variables.",
            "generator": "Xcode",
            "binaryDir": "${sourceDir}/build/Qt_6_10_2_for_iOS",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "iOS",
                "CMAKE_TOOLCHAIN_FILE": "$env{QT_IOS_ROOT}/lib/cmake/Qt6/qt.toolchain.cmake",
                "QTQUICKTEMPLATE_APPLE_DEVELOPMENT_TEAM": "$env{APPLE_DEVELOPMENT_TEAM}",
                "QTQUICKTEMPLATE_IOS_PROVISIONING_PROFILE": "$env{IOS_PROVISIONING_PROFILE}",
                "QTQUICKTEMPLATE_IOS_ARCHIVE_CONFIGURATION": "Release",
                "QTQUICKTEMPLATE_ASC_API_KEY_ID": "$env{ASC_API_KEY_ID}",
                "QTQUICKTEMPLATE_ASC_API_ISSUER_ID": "$env{ASC_API_ISSUER_ID}"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "macos-app",
            "displayName": "macOS App (build only)",
            "description": "Build the macOS app without packaging.",
            "configurePreset": "macos-release"
        },
        {
            "name": "macos-distributable",
            "displayName": "macOS Release Distributable",
            "description": "Full macOS pipeline: build, deploy Qt, create DMG, notarize, staple, and verify.",
            "configurePreset": "macos-release",
            "targets": ["ReleaseDistributableMacOS"]
        },
        {
            "name": "macos-appstore-app",
            "displayName": "macOS App Store App (build only)",
            "description": "Build the macOS app without App Store packaging.",
            "configurePreset": "macos-appstore",
            "configuration": "Release",
            "nativeToolOptions": ["-allowProvisioningUpdates", "CODE_SIGNING_ALLOWED=NO"]
        },
        {
            "name": "macos-appstore-distributable",
            "displayName": "macOS App Store Distributable",
            "description": "Full macOS App Store pipeline: build, archive, export PKG, verify, and upload to App Store Connect.",
            "configurePreset": "macos-appstore",
            "configuration": "Release",
            "targets": ["ReleaseDistributableMacOSAppStore"],
            "nativeToolOptions": ["-allowProvisioningUpdates", "CODE_SIGNING_ALLOWED=NO"]
        },
        {
            "name": "ios-app",
            "displayName": "iOS App (build only)",
            "description": "Build the app for iOS without packaging.",
            "configurePreset": "ios-release",
            "configuration": "Release",
            "nativeToolOptions": ["-allowProvisioningUpdates", "CODE_SIGNING_ALLOWED=NO"]
        },
        {
            "name": "ios-distributable",
            "displayName": "iOS Release Distributable",
            "description": "Full iOS pipeline: build, archive, export IPA, and verify. The outer build disables signing; the nested xcodebuild archive handles code signing with the distribution profile.",
            "configurePreset": "ios-release",
            "configuration": "Release",
            "targets": ["ReleaseDistributableIOS"],
            "nativeToolOptions": ["-allowProvisioningUpdates", "CODE_SIGNING_ALLOWED=NO"]
        }
    ]
}
