<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23166" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" initialViewController="vc-root">
  <device id="retina6_12" orientation="portrait" appearance="light"/>
  <dependencies>
    <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23129"/>
    <capability name="Safe area layout guides" minToolsVersion="9.0"/>
    <capability name="System colors in document resources" minToolsVersion="11.0"/>
  </dependencies>
  <scenes>
    <scene sceneID="scene-launch">
      <objects>
        <viewController id="vc-root" sceneMemberID="viewController">
          <view key="view" contentMode="scaleToFill" id="root-view">
            <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
            <color key="backgroundColor" red="0.039" green="0.039" blue="0.047" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
            <subviews>
              <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="QtQuickTemplate Demo" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" minimumScaleFactor="0.7" translatesAutoresizingMaskIntoConstraints="NO" id="title-label">
                <rect key="frame" x="47" y="280" width="300" height="32"/>
                <fontDescription key="fontDescription" type="system" weight="bold" pointSize="26"/>
                <color key="textColor" red="1" green="1" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
              </label>
              <imageView opaque="NO" userInteractionEnabled="NO" contentMode="scaleAspectFit" translatesAutoresizingMaskIntoConstraints="NO" image="AppLogo" clipsToSubviews="YES" id="logo">
                <rect key="frame" x="147" y="340" width="100" height="100"/>
                <color key="backgroundColor" red="0" green="0" blue="0" alpha="0" colorSpace="custom" customColorSpace="sRGB"/>
                <constraints>
                  <constraint firstAttribute="width" constant="100" id="logo-width"/>
                  <constraint firstAttribute="height" constant="100" id="logo-height"/>
                </constraints>
              </imageView>
              <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="from Matthew Crowell and&#10;Confederated Technologies, Inc." textAlignment="center" numberOfLines="2" lineBreakMode="wordWrap" baselineAdjustment="alignBaselines" minimumScaleFactor="0.7" translatesAutoresizingMaskIntoConstraints="NO" id="attribution-label">
                <rect key="frame" x="47" y="460" width="300" height="44"/>
                <fontDescription key="fontDescription" type="system" weight="light" pointSize="15"/>
                <color key="textColor" red="0.7" green="0.7" blue="0.7" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
              </label>
              <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Version unknown" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" minimumScaleFactor="0.8" translatesAutoresizingMaskIntoConstraints="NO" id="version-label">
                <rect key="frame" x="118" y="794" width="157" height="18"/>
                <fontDescription key="fontDescription" type="system" weight="regular" pointSize="13"/>
                <color key="textColor" red="0.5" green="0.5" blue="0.5" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
              </label>
            </subviews>
            <viewLayoutGuide key="safeArea" id="safe-area"/>
            <constraints>
              <constraint firstItem="title-label" firstAttribute="centerX" secondItem="root-view" secondAttribute="centerX" id="title-centerX"/>
              <constraint firstItem="title-label" firstAttribute="bottom" secondItem="logo" secondAttribute="top" constant="-24" id="title-above-logo"/>
              <constraint firstItem="title-label" firstAttribute="leading" relation="greaterThanOrEqual" secondItem="safe-area" secondAttribute="leading" constant="24" id="title-leading"/>
              <constraint firstItem="safe-area" firstAttribute="trailing" relation="greaterThanOrEqual" secondItem="title-label" secondAttribute="trailing" constant="24" id="title-trailing"/>
              <constraint firstItem="logo" firstAttribute="centerX" secondItem="root-view" secondAttribute="centerX" id="logo-centerX"/>
              <constraint firstItem="logo" firstAttribute="centerY" secondItem="root-view" secondAttribute="centerY" multiplier="0.8" id="logo-centerY"/>
              <constraint firstItem="attribution-label" firstAttribute="centerX" secondItem="root-view" secondAttribute="centerX" id="attr-centerX"/>
              <constraint firstItem="attribution-label" firstAttribute="top" secondItem="logo" secondAttribute="bottom" constant="24" id="attr-below-logo"/>
              <constraint firstItem="attribution-label" firstAttribute="leading" relation="greaterThanOrEqual" secondItem="safe-area" secondAttribute="leading" constant="24" id="attr-leading"/>
              <constraint firstItem="safe-area" firstAttribute="trailing" relation="greaterThanOrEqual" secondItem="attribution-label" secondAttribute="trailing" constant="24" id="attr-trailing"/>
              <constraint firstItem="version-label" firstAttribute="centerX" secondItem="root-view" secondAttribute="centerX" id="version-centerX"/>
              <constraint firstItem="safe-area" firstAttribute="bottom" secondItem="version-label" secondAttribute="bottom" constant="30" id="version-bottom"/>
            </constraints>
          </view>
        </viewController>
        <placeholder placeholderIdentifier="IBFirstResponder" id="first-responder" userLabel="First Responder" sceneMemberID="firstResponder"/>
      </objects>
      <point key="canvasLocation" x="53" y="375"/>
    </scene>
  </scenes>
  <resources>
    <image name="AppLogo" width="128" height="128"/>
  </resources>
</document>
