project     = QtQuickTemplate
description = QtQuickTemplate application documentation

# C++ headers and sources (QML-exposed types like AppInfo)
headerdirs  = ../include/main/common
sourcedirs  = ../src/main/common

# Include paths so QDoc can find project headers
includepaths = ../include/main/common

# QML sources across all three modules
sourcedirs += \
    ../libs/apptheme/qml \
    ../libs/appstyle/qml \
    ../qml \
    ../qml/organisms \
    ../qml/templates \
    ../qml/pages

# Module-level \qmlmodule declarations
sourcedirs += .

outputdir   = html
outputformats = HTML
